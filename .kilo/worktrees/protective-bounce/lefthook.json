{
  "pre-commit": {
    "parallel": true,
    "commands": {
      "check": {
        "glob": "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css,grit}",
        "run": "bunx @biomejs/biome check --write --no-errors-on-unmatched --files-ignore-unknown=true --colors=off {staged_files}",
        "stage_fixed": true
      },
      "mobile-verify": {
        "root": "apps/mobile/",
        "glob": "*.{ts,tsx,json}",
        "run": "bunx tsc --noEmit && bun test && bun run validate:content"
      }
    }
  },
  "commit-msg": {
    "commands": {
      "lint commit message": {
        "run": "bunx --no -- commitlint --edit \"$1\""
      }
    }
  }
}
