// RTL is free if logical directions are used from the first screen, and a sweep
// across every file if they aren't (see #19).
language js

or {
  JsPropertyObjectMember(name=$key) where {
    $key <: r"^(?:left|right|marginLeft|marginRight|paddingLeft|paddingRight|borderLeftWidth|borderRightWidth|borderLeftColor|borderRightColor|borderTopLeftRadius|borderTopRightRadius|borderBottomLeftRadius|borderBottomRightRadius)$",
    register_diagnostic(span=$key, message="Use logical directions (start/end, marginStart, paddingEnd, borderStartStartRadius) so RTL works without a rewrite.", severity="error")
  },
  JsxAttribute(name=$attr) as $a where {
    $attr <: r".*[cC]lassName",
    $a <: contains or {
      JsxString() as $s,
      JsStringLiteralExpression() as $s,
      JsTemplateChunkElement() as $s
    },
    $s <: r"(?s).*(?:^|[\s'\"`])-?(?:ml|mr|pl|pr|left|right|border-l|border-r|rounded-l|rounded-r|text-left|text-right)(?:-[^\s'\"`]*)?(?:[\s'\"`]|$).*",
    register_diagnostic(span=$s, message="Use logical Tailwind utilities (ms/me, ps/pe, start/end, rounded-s/rounded-e, text-start/text-end) so RTL works without a rewrite.", severity="error")
  }
}
