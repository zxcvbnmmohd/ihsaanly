{
  "name": "@ihsaanly/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Ihsaanly's presentational React Native screens and components, shared by the app and the web. Props in, JSX out: no stores, no router, layout and type as Tailwind classes, colours and fonts in style from the shared tokens. The host supplies strings, scheme, links and raw system colours through UiProvider.",
  "type": "module",
  "exports": {
    "./provider": "./src/provider.tsx",
    "./types": "./src/types.ts",
    "./screens/fixtures": "./src/screens/fixtures.ts",
    "./screens/*": "./src/screens/*.tsx",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ihsaanly/core": "workspace:*",
    "@ihsaanly/tailwind": "workspace:*"
  },
  "peerDependencies": {
    "expo-blur": "*",
    "expo-glass-effect": "*",
    "expo-haptics": "*",
    "expo-image": "*",
    "expo-linear-gradient": "*",
    "react": "*",
    "react-native": "*",
    "react-native-css": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@ihsaanly/lint": "workspace:*",
    "@ihsaanly/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
