{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": ["dist/**"]
    },
    "@ihsaanly/marketing#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/tooling/tailwind/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "@ihsaanly/marketing#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/tooling/tailwind/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@ihsaanly/mobile#dev": {
      "persistent": true,
      "cache": false,
      "interactive": true
    }
  }
}
