{
  "expo": {
    "name": "ihsaanly",
    "slug": "ihsaanly",
    "scheme": "ihsaanly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihsaanly.app",
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "package": "com.ihsaanly.app",
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "RightNowWidget",
              "displayName": "Right now",
              "description": "What the moment calls for.",
              "supportedFamilies": ["systemSmall"]
            },
            {
              "name": "QuickDuasWidget",
              "displayName": "Quick duas",
              "description": "The duas no sensor can find, one tap away.",
              "supportedFamilies": ["systemMedium"]
            }
          ]
        }
      ],
      "./plugins/with-android-manifest.js",
      "expo-asset",
      "expo-router",
      "expo-status-bar",
      "expo-image",
      ["expo-font", { "fonts": ["./assets/fonts/Amiri-Regular.ttf"] }],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ihsaanly uses your location on this device to work out prayer windows. It is never sent anywhere.",
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Ihsaanly can notice when you leave home so it can offer the dua for it. This is optional, off by default, and your location is never sent anywhere."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-audio"
    ]
  }
}
