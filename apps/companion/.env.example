# Optional cloud sync. Leave all of these unset for a local-only build.
# The first four are required together; copy to .env (gitignored) to enable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local Firebase emulators only, e.g. 127.0.0.1
VITE_FIREBASE_EMULATOR_HOST=

# Optional: where newer content (sunnah items, translations) is published, checked for the
# next open. https://ihsaanly.app/content (production), https://dev.ihsaanly.app/content
# (development). Leave unset to only ever show the content the build shipped with.
VITE_CONTENT_URL=
