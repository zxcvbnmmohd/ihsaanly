# Copy to .env (gitignored). Leave unset for a local-only build: no Account row, no Firebase.
# All five Firebase values plus the OAuth client id are needed to enable accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: host:port of the Firebase Auth/Firestore emulator.
VITE_FIREBASE_EMULATOR_HOST=
# Google OAuth "Web application" client id whose redirect URI is https://<extension-id>.chromiumapp.org/
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Optional: where newer content (sunnah items, translations) is published, checked for the
# next open. https://ihsaanly.app/content (production), https://dev.ihsaanly.app/content
# (development). Leave unset to only ever show the content the build shipped with.
VITE_CONTENT_URL=
