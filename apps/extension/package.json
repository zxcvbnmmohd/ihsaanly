{
  "name": "@ihsaanly/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Ihsaanly in the Chrome toolbar: today's Sunnah plan in a popup, and its reminders as Chrome notifications.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "package": "rm -rf dist ihsaanly-extension.zip && VITE_APP_ENV=production vite build && cd dist && zip -qrX ../ihsaanly-extension.zip . -x '.*' '*.map'",
    "package:beta": "rm -rf dist ihsaanly-extension-beta.zip && NODE_ENV=production VITE_APP_ENV=development vite build --mode development && cd dist && zip -qrX ../ihsaanly-extension-beta.zip . -x '.*' '*.map'",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./test",
    "test:coverage": "bun test --coverage ./src ./test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist *.zip"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.40",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "react-native-web": "catalog:",
    "react-native-css": "catalog:",
    "@ihsaanly/tailwind": "workspace:*",
    "@ihsaanly/cloud": "workspace:*",
    "@ihsaanly/core": "workspace:*",
    "@ihsaanly/state": "workspace:*",
    "@ihsaanly/ui": "workspace:*",
    "@ihsaanly/web": "workspace:*",
    "expo-blur": "~58.0.1",
    "expo-glass-effect": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-image": "~58.0.6",
    "expo-linear-gradient": "~58.0.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/bun": "catalog:",
    "@types/chrome": "^0.3.1",
    "@types/react": "catalog:",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "@ihsaanly/lint": "workspace:*",
    "@ihsaanly/tsconfig": "workspace:*",
    "@happy-dom/global-registrator": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@testing-library/jest-dom": "catalog:"
  }
}
