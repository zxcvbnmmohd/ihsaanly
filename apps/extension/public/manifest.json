{
  "manifest_version": 3,
  "name": "Ihsaanly",
  "description": "What you can do today, from the Sunnah — with gentle reminders.",
  "version": "0.0.1",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+I" } }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["alarms", "notifications", "storage", "geolocation", "identity"]
}
