# Copy to .env (gitignored). Leave the Firebase block empty for a local-only build.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional: host of the Firebase emulator suite, e.g. 192.168.1.10
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
# Google OAuth clients (Google Cloud console, same project as Firebase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
