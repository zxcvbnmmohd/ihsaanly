{
  "extends": ["expo/tsconfig.base.json", "@ihsaanly/tsconfig/base.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "react-native-view-shot": ["./types/react-native-view-shot.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "assets-env.d.ts",
    "nativewind-env.d.ts",
    "bun-env.d.ts"
  ]
}
