  "items": [
    {
      "id": "dua-leaving-home",
      "category": "home",
      "title": {
        "en": "Leaving home",
        "ar": "دعاء الخروج من المنزل"
      },
      "ruling": "sunnah",
      "arabic": "بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ",
      "transliteration": {
        "en": "Bismillāh, tawakkaltu ʿalā Allāh, wa lā ḥawla wa lā quwwata illā billāh"
      },
      "translation": {
        "en": "In the name of Allah, I place my trust in Allah, and there is no might nor power except with Allah."
      },
      "repeat": 1,
      "evidence": [
        {
          "type": "hadith",
          "collection": "Sunan Abi Dawud",
          "reference": "5095",
          "grading": "sahih",
          "gradedBy": "al-Albani",
          "text": {
            "en": "Whoever says, when he leaves his house, “In the name of Allah, I place my trust in Allah, and there is no might nor power except with Allah,” it is said to him: you are guided, sufficed and protected.",
            "ar": "مَنْ قَالَ — يَعْنِي إِذَا خَرَجَ مِنْ بَيْتِهِ — بِسْمِ اللَّهِ تَوَكَّلْتُ عَلَى اللَّهِ وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلَّا بِاللَّهِ"
          }
        }
      ],
      "trigger": {
        "kind": "event",
        "event": "leaving-home"
      },
      "defaultOn": true,
      "note": null,
      "audio": null,
      "audioTranslation": null
    },
    {
      "id": "dua-entering-masjid",
      "category": "masjid",
      "title": {
        "en": "Entering the masjid"
      },
      "ruling": "sunnah",
      "arabic": "اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ",
      "transliteration": {
        "en": "Allāhumma-ftaḥ lī abwāba raḥmatik"
      },
      "translation": {
        "en": "O Allah, open for me the doors of Your mercy."
      },
      "repeat": 1,
      "evidence": [
        {
          "type": "hadith",
          "collection": "Sahih Muslim",
          "reference": "713",
          "grading": "sahih",
          "gradedBy": null,
          "text": {
            "en": "When one of you enters the masjid, let him say: O Allah, open for me the doors of Your mercy."
          }
        }
      ],
      "trigger": {
        "kind": "event",
        "event": "entering-masjid"
      },
      "defaultOn": true,
      "note": null,
      "audio": null,
      "audioTranslation": null
    },
    {
      "id": "dua-travel",
      "category": "travel",
      "title": {
        "en": "Setting out on a journey"
      },
      "ruling": "sunnah",
      "arabic": "سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ",
      "transliteration": {
        "en": "Subḥāna-lladhī sakhkhara lanā hādhā wa mā kunnā lahu muqrinīn, wa innā ilā rabbinā la-munqalibūn"
      },
      "translation": {
        "en": "Glory be to the One who has subjected this to us, when we could never have done it ourselves; and to our Lord we shall surely return."
      },
      "repeat": 1,
      "evidence": [
        {
          "type": "hadith",
          "collection": "Sahih Muslim",
          "reference": "1342",
          "grading": "sahih",
          "gradedBy": null,
          "text": {
            "en": "When the Prophet mounted his camel to set out on a journey he would say: Glory be to the One who has subjected this to us, when we could never have done it ourselves."
          }
        }
      ],
      "trigger": {
        "kind": "event",
        "event": "travel"
      },
      "defaultOn": true,
      "note": null,
      "audio": null,
      "audioTranslation": null
    },
    {
      "id": "dua-sleeping",
      "category": "sleep",
      "title": {
        "en": "Going to sleep"
      },
      "ruling": "sunnah",
      "arabic": "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا",
      "transliteration": {
        "en": "Bismika-llāhumma amūtu wa aḥyā"
      },
      "translation": {
        "en": "In Your name, O Allah, I die and I live."
      },
      "repeat": 1,
      "evidence": [
        {
          "type": "hadith",
          "collection": "Sahih al-Bukhari",
          "reference": "6314",
          "grading": "sahih",
          "gradedBy": null,
          "text": {
            "en": "When the Prophet went to bed he would say: In Your name, O Allah, I die and I live."
          }
        }
      ],
      "trigger": {
        "kind": "event",
        "event": "sleeping"
      },
      "defaultOn": true,
      "note": null,
      "audio": null,
      "audioTranslation": null
    },
    {
      "id": "dua-waking",
      "category": "sleep",
      "title": {
        "en": "Waking up"
      },
      "ruling": "sunnah",
      "arabic": "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ",
      "transliteration": {
        "en": "Al-ḥamdu lillāhi-lladhī aḥyānā baʿda mā amātanā wa ilayhi-n-nushūr"
      },
      "translation": {
        "en": "Praise be to Allah who gave us life after causing us to die, and to Him is the resurrection."
      },
      "repeat": 1,
      "evidence": [
        {
          "type": "hadith",
          "collection": "Sahih al-Bukhari",
          "reference": "6312",
          "grading": "sahih",
          "gradedBy": null,
          "text": {
            "en": "When the Prophet woke he would say: Praise be to Allah who gave us life after causing us to die, and to Him is the resurrection."
          }
        }
      ],
      "trigger": {
        "kind": "event",
        "event": "waking"
      },
      "defaultOn": false,
      "note": null,
      "audio": null,
      "audioTranslation": null
