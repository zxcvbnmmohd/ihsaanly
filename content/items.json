      "repeat": 1,
      "evidence": [
        {
          "type": "quran",
          "surah": 2,
          "ayah": 255,
          "text": {
            "en": "Allah — there is no deity except Him, the Ever-Living, the Sustainer of existence."
          }
        },
        {
          "type": "hadith",
          "collection": "Sunan an-Nasa'i",
          "reference": "9928",
          "grading": "sahih",
          "gradedBy": "al-Albani",
          "text": {
            "en": "Whoever recites Ayat al-Kursi after every obligatory prayer, nothing stands between him and entering Paradise but death."
