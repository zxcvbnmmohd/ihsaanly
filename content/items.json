          "collection": "Sahih al-Bukhari",
          "reference": "1178",
          "grading": "sahih",
          "gradedBy": null,
          "text": {
            "en": "My friend advised me to do three things: to fast three days of every month, to pray two rak’ah of Duha, and to pray Witr before sleeping."
