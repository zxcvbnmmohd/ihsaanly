      "category": "dhikr",
      "title": {
        "en": "Tasbih after prayer"
      },
      "ruling": "sunnah",
      "arabic": "سُبْحَانَ اللَّهِ",
      "transliteration": {
        "en": "Subḥāna-llāh"
      },
      "translation": {
        "en": "Glory be to Allah."
      },
      "repeat": 33,
      "evidence": [
        {
          "type": "hadith",
          "collection": "Sahih Muslim",
          "reference": "597",
          "grading": "sahih",
          "gradedBy": null,
          "text": {
            "en": "Whoever glorifies Allah thirty-three times after each prayer, praises Him thirty-three times and magnifies Him thirty-three times, then completes the hundred, his sins are forgiven even if they are like the foam of the sea."
          }
        }
      ],
      "trigger": {
