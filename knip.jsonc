{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  // Dependency problems fail `bun run check`. Unused files and exports are
  // reported as warnings for review rather than blocking.
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn"
  },
  // The component-test harness (packages/ui/test, docs/TESTING.md) is
  // installed in every workspace that renders React, so tests can be added
  // without touching a package.json; a workspace with no component test yet
  // would otherwise report them unused.
  "ignoreDependencies": [
    "@happy-dom/global-registrator",
    "@testing-library/dom",
    "@testing-library/jest-dom",
    "@testing-library/react",
    "@testing-library/user-event"
  ],
  "workspaces": {
    ".": {
      // The end-to-end suites (playwright.config.ts) and the root scripts.
      "entry": ["scripts/*.ts", "e2e/**/*.spec.ts", "e2e/support/serve.ts"],
      "ignoreDependencies": [
        // cz-git runs through commitizen
        "commitizen",
        // installs the git hooks from lefthook.json, never imported
        "lefthook",
        // for the accessibility checks the e2e suites will add
        "@axe-core/playwright"
      ]
    },
    "apps/mobile": {
      "entry": ["scripts/*.ts", "plugins/*.js", "src/**/*.test.{ts,tsx}"],
      // Guessed by knip's Expo plugin from app.json keys; expo-doctor decides
      // which config packages are actually required.
      "ignoreDependencies": ["expo-updates", "expo-system-ui"]
    },
    "packages/core": {
      // Consumers import any module through the `./*` export; tests are the
      // package's own entry points.
      "entry": ["src/**/*.test.ts"]
    },
    "apps/marketing": {
      "entry": ["src/routes/**/*.tsx", "scripts/*.ts", "test/*.ts", "src/**/*.test.{ts,tsx}"]
    },
    "packages/state": {
      // Consumers import any module through the `./*` export; tests are the
      // package's own entry points.
      "entry": ["src/**/*.test.ts"]
    },
    "packages/cloud": {
      // Apps import the platform flows through the `./*` export; the rules
      // suite runs under the emulator via `test:rules`.
      "entry": ["src/**/*.test.ts", "src/firebase/flows/*.ts", "test/*.ts"]
    },
    "packages/web": {
      // Both web apps import through the subpath exports.
      "entry": ["src/*.{ts,tsx}", "src/hosting/*.ts", "src/**/*.test.{ts,tsx}"],
      // For component tests through the shared harness (docs/TESTING.md).
      "ignoreDependencies": ["react-dom", "@types/react-dom"]
    },
    "apps/companion": {
      "entry": ["src/routes/**/*.tsx", "scripts/*.ts", "test/*.ts", "src/**/*.test.{ts,tsx}"]
    },
    "packages/ui": {
      // Apps import any screen or component through the subpath exports;
      // tests are the package's own entry points.
      "entry": [
        "src/screens/*.{ts,tsx}",
        "src/components/*.tsx",
        "src/today/*.{ts,tsx}",
        "src/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        // The component-test harness: preloaded from bunfig.toml, imported by tests.
        "test/*.{ts,tsx}"
      ]
    }
  }
}
