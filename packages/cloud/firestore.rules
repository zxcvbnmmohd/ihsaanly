rules_version = '2';

// Every user owns exactly their own subtree, and may create feedback;
// everything else is closed.
// Shapes mirror src/firebase/sync-remote.ts. `updatedAt == request.time`
// forces serverTimestamp(), which the pull cursor depends on.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function stamped() {
      return request.resource.data.updatedAt == request.time;
    }

    function exactKeys(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      // Written once per device and account; a later device rewrites the same
      // two fields, so create and update are the same check.
      allow create, update: if isOwner(uid)
        && exactKeys(request.resource.data, ['createdAt', 'schemaVersion'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.schemaVersion is int;

      // One collection for everything that syncs, so a single query on
      // `updatedAt` finds every changed month and the preferences.
      match /sync/{docId} {
        function validPreferences() {
          let data = request.resource.data;
          return exactKeys(data, ['type', 'preferences', 'updatedAt'])
            && data.type == 'preferences'
            && data.preferences is map
            && data.preferences.size() <= 64
            && stamped();
        }

        // ponytail: 3000 events a month (~100 a day) keeps a doc far below 1 MiB.
        function validMonth() {
          let data = request.resource.data;
          return exactKeys(data, ['type', 'month', 'events', 'updatedAt'])
            && data.type == 'events'
            && data.month == docId
            && data.events is map
            && data.events.size() <= 3000
            && stamped();
        }

        function isMonth() {
          return docId.matches('^[0-9]{4}-[0-9]{2}$');
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && ((docId == 'preferences' && validPreferences()) || (isMonth() && validMonth()));
        // Months are append-only: an update may add events but never drop one.
        allow update: if isOwner(uid)
          && ((docId == 'preferences' && validPreferences())
            || (isMonth() && validMonth()
              && request.resource.data.events.keys().hasAll(resource.data.events.keys())));
      }

      // Layout 1, before users/{uid}/sync. Clients no longer write it; the
      // owner may still read and delete it so erasing an account removes it.
      // Remove both matches once no layout-1 data can be left (a release
      // after every client syncs in layout 2).
      match /eventMonths/{month} {
        allow read, delete: if isOwner(uid);
      }

      match /state/{doc} {
        allow read, delete: if isOwner(uid) && doc == 'preferences';
      }
    }

    // Feedback is top-level so erasing an account leaves it (kept up to 2
    // years). Create-only: nobody reads, edits or deletes it from a client;
    // the admin uses the console, where IAM bypasses these rules. Shapes
    // mirror src/firebase/feedback.ts.
    match /feedback/{id} {
      function validApp(app) {
        return app is map
          && app.keys().hasOnly(['surface', 'version', 'locale', 'os'])
          && app.keys().hasAll(['surface', 'version', 'locale', 'os'])
          && app.surface in ['ios', 'android', 'web', 'extension']
          && app.version is string && app.version.size() <= 64
          && app.locale is string && app.locale.size() <= 35
          && app.os is string && app.os.size() <= 64;
      }

      function validFeedback(data) {
        return data.keys().hasOnly(['uid', 'kind', 'message', 'contactEmail', 'app', 'diagnostics', 'createdAt', 'status'])
          && data.keys().hasAll(['uid', 'kind', 'message', 'contactEmail', 'app', 'diagnostics', 'createdAt', 'status'])
          && data.uid == request.auth.uid
          && data.kind in ['bug', 'idea', 'other']
          && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
          && (data.contactEmail == null
            || (data.contactEmail is string && data.contactEmail.size() <= 254))
          && validApp(data.app)
          // ponytail: a top-level key cap; FeedbackDiagnostics has 12. The
          // 1 MiB document limit bounds the rest.
          && (data.diagnostics == null
            || (data.diagnostics is map && data.diagnostics.size() <= 16))
          && data.createdAt == request.time
          && data.status == 'new';
      }

      // The rate limit: this batch must stamp feedbackLimits/{uid} with the
      // same request.time, and the stamp it replaces (if any) must be at
      // least a minute old. One account cannot flood the daily write quota.
      // A stamp written before the rename carries `lastAt`; it counts the
      // same until the next send replaces it (drop the fallback with the
      // layout-1 matches above).
      function withinLimit() {
        let limit = /databases/$(database)/documents/feedbackLimits/$(request.auth.uid);
        return getAfter(limit).data.lastSentAt == request.time
          && (!exists(limit)
            || get(limit).data.get('lastSentAt', get(limit).data.get('lastAt', timestamp.value(0)))
              <= request.time - duration.value(60, 's'));
      }

      allow create: if request.auth != null
        && validFeedback(request.resource.data)
        && withinLimit();
    }

    // The last send's time, per account. Never read or deleted by a client: a
    // delete before each send would sidestep the 60 s limit. Kept after the
    // account is erased, like the feedback it limits.
    match /feedbackLimits/{uid} {
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastSentAt'])
        && request.resource.data.lastSentAt == request.time;
    }
  }
}
