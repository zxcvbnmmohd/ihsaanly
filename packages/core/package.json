{
  "name": "@ihsaanly/core",
  "version": "0.0.0",
  "private": true,
  "description": "Ihsaanly's pure domain: the content and its schema, prayer times and windows, the Hijri calendar, the daily plan, and the string tables. No React, no native modules, no storage; both apps import it.",
  "type": "module",
  "exports": {
    "./content": "./src/content/index.ts",
    "./content/*.json": "./content/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@umalqura/core": "^0.0.7",
    "adhan": "^4.4.6",
    "city-timezones": "^1.3.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ihsaanly/lint": "workspace:*",
    "@ihsaanly/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
