// Explicit over implicit: every declared function and component states what it
// returns. Inline callbacks passed to an already-typed prop are exempt, as they
// were under @typescript-eslint/explicit-function-return-type.
language js

or {
  JsFunctionDeclaration(id=$name, return_type_annotation=.) where {
    register_diagnostic(span=$name, message="Declare the return type of this function.", severity="error")
  },
  JsVariableDeclarator(id=$name, variable_annotation=., initializer=JsInitializerClause(expression=or {
    JsArrowFunctionExpression(return_type_annotation=.),
    JsFunctionExpression(return_type_annotation=.)
  })) where {
    register_diagnostic(span=$name, message="Declare the return type of this function, or type the variable.", severity="error")
  }
}
