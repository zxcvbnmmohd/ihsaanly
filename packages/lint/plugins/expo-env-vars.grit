// Ports of eslint-plugin-expo's no-dynamic-env-var and no-env-var-destructuring:
// Expo inlines process.env.EXPO_PUBLIC_* only when each access is static.
language js

or {
  `process.env[$key]` as $e where {
    register_diagnostic(span=$e, message="Read env vars as process.env.NAME. Expo cannot inline a computed key.", severity="error")
  },
  JsVariableDeclarator(id=JsObjectBindingPattern(), initializer=$init) as $d where {
    $init <: contains `process.env`,
    register_diagnostic(span=$d, message="Do not destructure process.env. Expo inlines only direct process.env.NAME reads.", severity="error")
  }
}
