{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env"],
  "globalPassThroughEnv": ["E2E_BUILD", "MISE_BIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production.local",
        ".env.local",
        ".env.production",
        ".env"
      ],
      "outputs": ["dist/**"]
    },
    "@ihsaanly/marketing#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/packages/web/**",
        "$TURBO_ROOT$/tooling/tailwind/**"
      ],
      "outputs": ["dist/**"],
      "env": ["VITE_COMPANION_URL", "VITE_APP_ENV", "VITE_CONTENT_URL"]
    },
    "@ihsaanly/companion#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tooling/tailwind/**",
        ".env.production",
        ".env"
      ],
      "outputs": ["dist/**"],
      "env": [
        "VITE_FIREBASE_*",
        "VITE_GOOGLE_OAUTH_CLIENT_ID",
        "VITE_APP_ENV",
        "VITE_SITE_URL",
        "VITE_CONTENT_URL"
      ]
    },
    "@ihsaanly/extension#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tooling/tailwind/**",
        ".env.production",
        ".env"
      ],
      "outputs": ["dist/**"],
      "env": ["VITE_FIREBASE_*", "VITE_GOOGLE_OAUTH_CLIENT_ID", "VITE_APP_ENV", "VITE_CONTENT_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "@ihsaanly/marketing#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/packages/web/**",
        "$TURBO_ROOT$/tooling/tailwind/**"
      ]
    },
    "@ihsaanly/marketing#test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/core/**",
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/packages/web/**",
        "$TURBO_ROOT$/tooling/tailwind/**"
      ],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "@ihsaanly/mobile#dev": {
      "persistent": true,
      "cache": false,
      "interactive": true
    }
  }
}
